---
benchmark:
  id: zeek-parse-kv
  description: Parse Zeek conn key-value lines
  tags:
    dataset: zeek-conn
    operator: parse_kv
  input:
    path: zeek/conn.kv.log
    events: 583838
    measure: true
  env:
    TENZIR_CONSOLE_FORMAT: none
  runtime:
    warmup_runs: 1
    measurement_runs: 3
    timeout_seconds: 900
---
from_file f"{env("BENCHMARK_INPUT_PATH")}" {
  read_lines
}
this = move line.parse_kv(field_split=r"\s+", value_split=r"=")
discard
