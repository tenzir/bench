---
benchmark:
  id: suricata-summarize-event-type
  description: Summarize Suricata events by event_type
  tags:
    dataset: suricata-eve
    operator: summarize
  input:
    path: suricata/eve.json
    events: 984865
    measure: true
  env:
    TENZIR_CONSOLE_FORMAT: none
  runtime:
    warmup_runs: 1
    measurement_runs: 3
    timeout_seconds: 900
---
from_file f"{env('BENCHMARK_INPUT_PATH')}" {
  read_json
}
summarize event_type, events=count(), to_server=sum(flow.bytes_toserver), to_client=sum(flow.bytes_toclient)
discard
