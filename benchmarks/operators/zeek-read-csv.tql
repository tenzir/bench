---
benchmark:
  id: zeek-read-csv
  description: Read Zeek conn records from CSV
  tags:
    dataset: zeek-conn
    operator: read_csv
  input:
    path: zeek/conn.csv
    events: 583838
    measure: true
  env:
    TENZIR_CONSOLE_FORMAT: none
  runtime:
    warmup_runs: 1
    measurement_runs: 3
    timeout_seconds: 900
---
from_file f"{env("BENCHMARK_INPUT_PATH")}" {
  read_csv
}
discard
