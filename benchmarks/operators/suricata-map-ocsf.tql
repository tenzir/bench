---
benchmark:
  id: suricata-map-ocsf
  description: Map Suricata EVE JSON events to OCSF via the vendored package
  tags:
    dataset: suricata-eve
    operator: suricata_ocsf_map
  input:
    path: suricata/eve.json
    events: 984865
    measure: true
  env:
    TENZIR_CONSOLE_FORMAT: none
  tenzir_args:
    - --package-dirs=/home/tobim/t/bench/packages
  runtime:
    warmup_runs: 1
    measurement_runs: 3
    timeout_seconds: 900
---
from_file f"{env("BENCHMARK_INPUT_PATH")}" {
  read_suricata
}
suricata::ocsf::map
discard
