---
benchmark:
  id: zeek-read-kv
  description: Read Zeek conn records from key-value log
  tags:
    dataset: zeek-conn
    operator: read_kv
  input:
    path: zeek/conn.kv.log
    events: 583838
    measure: true
  env:
    TENZIR_CONSOLE_FORMAT: none
  runtime:
    warmup_runs: 1
    measurement_runs: 3
    timeout_seconds: 900
---
from_file f"{env("BENCHMARK_INPUT_PATH")}" {
  read_kv
}
discard
