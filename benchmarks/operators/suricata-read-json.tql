---
benchmark:
  id: suricata-read-json
  description: Read Suricata EVE records via read_json
  tags:
    dataset: suricata-eve
    operator: read_json
  input:
    path: suricata/eve.json
    events: 984865
    measure: true
  env:
    TENZIR_CONSOLE_FORMAT: none
  runtime:
    warmup_runs: 1
    measurement_runs: 3
    timeout_seconds: 900
---
from_file f"{env("BENCHMARK_INPUT_PATH")}" {
  read_json
}
discard
