---
benchmark:
  id: suricata-from-kafka
  description: Read Suricata EVE records from Kafka via from_kafka
  tags:
    dataset: suricata-eve
    operator: from_kafka
  input:
    path: suricata/eve.json
    events: 984865
    measure: true
  env:
    TENZIR_CONSOLE_FORMAT: none
  fixtures:
    - kafka:
        topic: suricata-eve-bench
  runtime:
    warmup_runs: 1
    measurement_runs: 3
    timeout_seconds: 900
---
from_kafka f"{env("BENCHMARK_KAFKA_TOPIC")}",
  count=984865,
  offset="beginning",
  options={
    "bootstrap.servers": f"{env("BENCHMARK_KAFKA_BOOTSTRAP_SERVERS")}",
    "group.id": f"{env("BENCHMARK_KAFKA_GROUP_ID")}",
  }
this = move message.parse_json()
discard
